{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AmpCore",
  "version": "0.1.8",
  "identifier": "com.scalli.ampcore",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AmpCore",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 380,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRTVBNzA4MzFFNEZFRUMKUldUcy91UXhDS2ZsNGpPNnlTNllZaERWaXNtVndYSXh1YXlOOFVWOFhFVXpsT0NhTGtPMDNRK0cK",
      "endpoints": [
        "https://github.com/scalli007YT/ampcore-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
