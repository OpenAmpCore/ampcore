<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark window (no white flash before the WebView paints) and transparent
         system bars: the page draws under them and pads with the safe-area insets. -->
    <style name="Theme.ampcore_mobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#0a0b0c</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
