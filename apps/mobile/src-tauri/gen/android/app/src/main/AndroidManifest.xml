<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to receive the amp's UDP broadcast discovery replies — Android
         filters non-multicast-locked broadcast traffic by default. See
         ampcore-core's live/cvr/driver.rs discovery loop and the monorepo
         plan's step 0 findings for why (WifiManager.MulticastLock must also
         be acquired for the socket's lifetime; that's app-side Kotlin/Java
         work, not something this manifest line alone provides). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ampcore_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <!-- No `screenOrientation`: the app follows the device. It used to
                 be locked to `sensorLandscape`, which made a phone 834x375 dp —
                 375dp of height for everything, and wide enough that any
                 width-based CSS breakpoint read a phone as a tablet. The layout
                 flips axis on orientation instead (see PathRail in path.tsx),
                 and phone/tablet is decided by the short side, Android's own
                 sw600dp rule (the `tablet` variant in styles.css).

                 Dropping the lock also retires the
                 PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY opt-out that used
                 to sit here: it only existed to keep the lock working on
                 >= sw600dp displays under Android 16, and Google removes it at
                 API 37 anyway. `configChanges` above still applies — it only
                 stops the activity being recreated on rotation. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
