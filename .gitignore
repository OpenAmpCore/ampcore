# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cargo workspace build output (cargo now builds at the workspace root)
/target/

# Tauri build output
/src-tauri/target/
/src-tauri/gen/

# apps/mobile/src-tauri/gen/android and gen/apple (once ios exists) are
# committed, not ignored: unlike desktop's gen/ (pure schema dump, safe to
# regenerate from nothing), a mobile gen/ project carries real, otherwise-
# unrecoverable customization (AndroidManifest.xml permissions, Gradle
# config) and ships its own nested .gitignore for the actual build output
# (gradle caches, local.properties, keystores). Only gen/schemas here is
# the same ephemeral capabilities dump desktop has.
/apps/mobile/src-tauri/gen/schemas/

# TypeScript incremental build state (tsconfig.node.json is a composite
# project, so `tsc -b` drops a .tsbuildinfo next to it)
*.tsbuildinfo

# Claude Code per-machine settings — the shared .claude/settings.json,
# if one is ever added, stays tracked
.claude/settings.local.json

# Secrets - never commit signing material
*.key
*.pem
.env
.env.*
CLAUDE.md
